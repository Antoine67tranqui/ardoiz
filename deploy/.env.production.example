# Copier en ".env" dans ce dossier (deploy/) puis remplir. Ce fichier ne doit JAMAIS etre versionne.
# Generer les secrets avec : sh deploy/generate-secrets.sh

# --- Domaine et certificat HTTPS ---
DOMAIN=carne.example.bj
ACME_EMAIL=contact@example.bj

# --- Base de donnees (valeur hexadecimale, sans caracteres speciaux) ---
DB_PASSWORD=

# --- Secrets de l'API : trois valeurs DIFFERENTES de 32 caracteres au moins ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_OTP_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Sauvegardes : cle PUBLIQUE age (age1...), la cle privee reste sur votre poste ---
BACKUP_AGE_RECIPIENT=

# --- SMS (Africa's Talking) : sans ces valeurs, AUCUN SMS reel n'est envoye ---
SMS_PROVIDER=africastalking
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=

# --- WhatsApp Business (facultatif, non utilise tant que vide) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Paiement Mobile Money : laisser VIDE tant que l'integration n'est pas verifiee ---
# Le paiement en ligne reste ferme en production tant que ces valeurs sont absentes
# (l'application l'indique franchement). Voir docs/guide-deploiement.md, etape FedaPay.
MOMO_PROVIDER=fedapay
MOMO_API_KEY=
MOMO_SITE_ID=
MOMO_WEBHOOK_SECRET=
