# NODE_ENV n'est volontairement pas defini ici : l'image Docker est en "production"
# par defaut, et la production refuse de demarrer avec des secrets d'exemple
# ("change-me-...") ou trop courts (voir src/config/env.validation.ts).
DATABASE_URL="postgresql://ardoiz:ardoiz@localhost:5432/ardoiz?schema=public"
# En production : trois secrets DIFFERENTS d'au moins 32 caracteres, par ex.
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Secret dedie aux jetons de session OTP (etape intermediaire entre la
# verification du code SMS et la connexion) et aux empreintes des codes OTP.
JWT_OTP_SECRET="change-me-otp-session-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# Nombre de reverse proxys / tunnels de confiance devant l'API (0 = aucun).
# A renseigner des que l'API est derriere un proxy : sinon le rate limiting par
# IP voit l'adresse du proxy et traite tous les utilisateurs comme un seul.
TRUST_PROXY=0

# Origines autorisees pour CORS, separees par des virgules. L'application mobile
# n'envoie pas d'en-tete Origin et le site vitrine n'appelle pas l'API : en
# production on laisse vide (aucune origine navigateur autorisee), sauf si un
# futur client web est ajoute. Aucune valeur = aucune origine autorisee.
CORS_ORIGINS=""

# SMS gateway (Africa's Talking)
# - SMS_USERNAME="sandbox" pour tester gratuitement avant la mise en prod
# - En prod, mettre le nom d'utilisateur de votre application Africa's Talking
SMS_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID=""

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Mobile Money aggregator (CinetPay / PayDunya)
MOMO_PROVIDER="cinetpay"
MOMO_API_KEY=""
MOMO_SITE_ID=""
MOMO_WEBHOOK_SECRET="change-me-webhook-secret"
