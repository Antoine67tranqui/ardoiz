<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de Carné ne quitte le téléphone par sauvegarde Google ni par transfert d'appareil :
     la base locale est chiffrée avec une clé liée au coffre de CE téléphone, elle serait illisible ailleurs.
     Les données se retrouvent depuis le serveur à la connexion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
