{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ardoiz-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--prefix", "ardoiz-backend"],
      "port": 3000
    },
    {
      "name": "ardoiz-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "ardoiz-web"],
      "port": 8080
    }
  ]
}
