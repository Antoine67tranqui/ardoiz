NODE_ENV="development"
DATABASE_URL="postgresql://ardoiz:ardoiz@localhost:5432/ardoiz?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Secret dedie aux jetons de session OTP (etape intermediaire entre la
# verification du code SMS et la connexion). Distinct de JWT_ACCESS_SECRET.
JWT_OTP_SECRET="change-me-otp-session-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# Origines autorisees pour CORS, separees par des virgules (ex: l'app web et
# le site vitrine). Aucune valeur = aucune origine autorisee.
CORS_ORIGINS="http://localhost:5173"

# SMS gateway (Africa's Talking)
# - SMS_USERNAME="sandbox" pour tester gratuitement avant la mise en prod
# - En prod, mettre le nom d'utilisateur de votre application Africa's Talking
SMS_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID=""

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Mobile Money aggregator (CinetPay / PayDunya)
MOMO_PROVIDER="cinetpay"
MOMO_API_KEY=""
MOMO_SITE_ID=""
MOMO_WEBHOOK_SECRET="change-me-webhook-secret"
